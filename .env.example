# Windows System Monitoring Configuration
# Copy this file to .env and adjust variables as needed.

# Server Configuration
HOST=127.0.0.1
PORT=8080

# Monitoring Intervals (in seconds)
INTERVAL_REALTIME=1.0
INTERVAL_PROCESS=2.0
INTERVAL_SOCKETS=3.0
INTERVAL_SERVICES=5.0
INTERVAL_STORAGE_IO=1.0

# Dahoo Cloud AI (Optional)
# If provided, Dahoo will support complex natural language reasoning and troubleshooting.
# If omitted or empty, Dahoo operates purely via its offline 0-token Local Rule Engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telemetry Retention (hours)
DETAILED_RETENTION_HOURS=24
AGGREGATED_RETENTION_DAYS=7
